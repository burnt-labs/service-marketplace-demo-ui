        "required": [
          "admin_force_release"
        ],
        "properties": {
          "admin_force_release": {
            "type": "object",
            "required": [
              "ask_id",
              "recipient"
            ],
            "properties": {
              "ask_id": {
                "type": "string"
              },
              "recipient": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Resolve a dispute by sending an arbitrary amount to a recipient.",
