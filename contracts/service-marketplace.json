  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "Create a new ask (request for work). `budget` is informational.",
        "type": "object",
        "required": [
          "create_ask"
        ],
        "properties": {
          "create_ask": {
            "type": "object",
            "required": [
              "budget"
            ],
            "properties": {
              "budget": {
                "$ref": "#/definitions/Coin"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Select a winning bid and lock funds into escrow. Must send funds == bid.price.",
        "type": "object",
        "required": [
          "select_bid"
        ],
        "properties": {
          "select_bid": {
            "type": "object",
            "required": [
              "ask_id",
              "bid_id"
            ],
            "properties": {
              "ask_id": {
                "type": "string"
              },
              "bid_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Release a partial amount from escrow. Callable by ask creator or admin.",
        "type": "object",
        "required": [
          "partial_disbursement"
        ],
        "properties": {
          "partial_disbursement": {
            "type": "object",
            "required": [
              "amount",
              "ask_id",
              "recipient"
            ],
            "properties": {
              "amount": {
                "$ref": "#/definitions/Coin"
              },
              "ask_id": {
                "type": "string"
              },
              "recipient": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Confirm the provider's completion and release remaining escrowed funds.",
        "type": "object",
        "required": [
          "confirm_completion"
        ],
        "properties": {
          "confirm_completion": {
            "type": "object",
            "required": [
              "ask_id"
            ],
            "properties": {
              "ask_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Cancel an Open ask (no escrow involved).",
        "type": "object",
        "required": [
          "cancel_ask"
        ],
        "properties": {
          "cancel_ask": {
            "type": "object",
            "required": [
              "ask_id"
            ],
            "properties": {
              "ask_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Submit a bid on an open ask. No funds required.",
        "type": "object",
        "required": [
          "submit_bid"
        ],
        "properties": {
          "submit_bid": {
            "type": "object",
            "required": [
              "ask_id",
              "price"
            ],
            "properties": {
              "ask_id": {
                "type": "string"
              },
              "funds_recipient": {
                "description": "Override payout address. Defaults to sender if omitted.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "price": {
                "$ref": "#/definitions/Coin"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Mark work as complete. Transitions InProgress → WorkSubmitted.",
        "type": "object",
        "required": [
          "mark_complete"
        ],
        "properties": {
          "mark_complete": {
            "type": "object",
            "required": [
              "ask_id"
            ],
            "properties": {
              "ask_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Cancel any active ask and refund locked funds.",
        "type": "object",
        "required": [
          "admin_cancel"
        ],
        "properties": {
          "admin_cancel": {
            "type": "object",
            "required": [
              "ask_id",
              "refund_to"
            ],
            "properties": {
              "ask_id": {
                "type": "string"
              },
              "refund_to": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Force-release all locked funds to a given recipient.",
