          "admin_resolve"
        ],
        "properties": {
          "admin_resolve": {
            "type": "object",
            "required": [
              "amount",
              "ask_id",
              "recipient"
            ],
            "properties": {
              "amount": {
                "$ref": "#/definitions/Coin"
              },
              "ask_id": {
                "type": "string"
              },
              "recipient": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Transfer admin rights to a new address.",
